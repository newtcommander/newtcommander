/////////////////////////////////////////////////////////////////////////////
// Dialogs

IDD_CONNECT DIALOGEX 0, 0, 340, 250
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to SFTP Server"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "&Bookmarks:", IDT_BOOKMARKS, 7, 7, 100, 8
    LISTBOX         IDL_BOOKMARKS, 7, 17, 110, 183, LBS_NOINTEGRALHEIGHT | LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&New", IDB_NEWBOOKMARK, 7, 204, 52, 14
    PUSHBUTTON      "D&uplicate", IDB_COPYBOOKMARK, 63, 204, 54, 14
    PUSHBUTTON      "&Rename", IDB_RENAMEBOOKMARK, 7, 222, 52, 14
    PUSHBUTTON      "&Delete", IDB_REMOVEBOOKMARK, 63, 222, 54, 14

    LTEXT           "&Host:", IDT_HOSTADDRESS, 125, 9, 40, 8
    EDITTEXT        IDE_HOSTADDRESS, 165, 7, 120, 12, ES_AUTOHSCROLL
    LTEXT           "P&ort:", IDT_PORT, 289, 9, 18, 8
    EDITTEXT        IDE_PORT, 307, 7, 26, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "&User:", IDT_USERNAME, 125, 25, 40, 8
    EDITTEXT        IDE_USERNAME, 165, 23, 120, 12, ES_AUTOHSCROLL

    AUTORADIOBUTTON "&Password", IDC_AUTHPASSWORD, 125, 43, 60, 10, WS_GROUP
    AUTORADIOBUTTON "Private &key", IDC_AUTHKEY, 190, 43, 70, 10

    LTEXT           "Pass&word:", IDT_PASSWORD, 125, 59, 40, 8
    EDITTEXT        IDE_PASSWORD, 165, 57, 120, 12, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX    "&Save password", IDC_SAVEPASSWORD, 165, 72, 120, 10

    LTEXT           "Key &file:", IDT_KEYFILE, 125, 89, 40, 8
    EDITTEXT        IDE_KEYFILE, 165, 87, 100, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "...", IDB_BROWSEKEY, 267, 87, 18, 12
    LTEXT           "Pass&phrase:", IDT_PASSPHRASE, 125, 105, 40, 8
    EDITTEXT        IDE_PASSPHRASE, 165, 103, 120, 12, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX    "Save p&assphrase", IDC_SAVEPASSPHRASE, 165, 118, 120, 10

    LTEXT           "&Initial path:", IDT_INITIALPATH, 125, 135, 40, 8
    EDITTEXT        IDE_INITIALPATH, 165, 133, 120, 12, ES_AUTOHSCROLL

    DEFPUSHBUTTON   "Co&nnect", IDB_CONNECT, 165, 222, 50, 14
    PUSHBUTTON      "Sa&ve", IDB_SAVEBOOKMARK, 221, 222, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 283, 222, 50, 14
END

IDD_PASSWORD DIALOGEX 0, 0, 220, 66
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SFTP Client"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDT_PROMPTTEXT, 7, 7, 206, 18
    EDITTEXT        IDE_PROMPTPASSWORD, 7, 28, 206, 12, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON   "OK", IDOK, 105, 46, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 163, 46, 50, 14
END

IDD_HOSTKEY DIALOGEX 0, 0, 300, 150
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Verify Host Key"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    // The icon is set at run time (STM_SETICON in HostKeyProc), not named here.
    // Naming a resource ordinal as an ICON control's title crashes the
    // Translator while exporting this dialog, and it could not resolve anyway:
    // warning.ico lives in sftp.spl while this template lives in the .slg.
    ICON            "", IDI_HOSTKEY_WARN, 7, 7, 20, 20
    LTEXT           "", IDT_HOSTKEY_TEXT, 35, 7, 258, 96
    DEFPUSHBUTTON   "&Trust and Store", IDB_HOSTKEY_TRUST, 35, 112, 76, 14
    PUSHBUTTON      "Connect &Once", IDB_HOSTKEY_ONCE, 117, 112, 76, 14
    PUSHBUTTON      "&Abort", IDCANCEL, 243, 112, 50, 14
END

IDD_CHMOD DIALOGEX 0, 0, 210, 176
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Change Permissions"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "", IDT_CHMODTARGET, 7, 7, 196, 8
    LTEXT           "Owner", IDC_STATIC_1, 40, 22, 40, 8
    LTEXT           "Group", IDC_STATIC_2, 90, 22, 40, 8
    LTEXT           "Others", IDC_STATIC_3, 140, 22, 40, 8
    LTEXT           "Read", IDC_STATIC_4, 7, 36, 30, 8
    AUTOCHECKBOX    "", IDC_UR, 40, 35, 12, 10
    AUTOCHECKBOX    "", IDC_GR, 90, 35, 12, 10
    AUTOCHECKBOX    "", IDC_OR, 140, 35, 12, 10
    LTEXT           "Write", IDC_STATIC_5, 7, 50, 30, 8
    AUTOCHECKBOX    "", IDC_UW, 40, 49, 12, 10
    AUTOCHECKBOX    "", IDC_GW, 90, 49, 12, 10
    AUTOCHECKBOX    "", IDC_OW, 140, 49, 12, 10
    LTEXT           "Execute", IDC_STATIC_6, 7, 64, 30, 8
    AUTOCHECKBOX    "", IDC_UX, 40, 63, 12, 10
    AUTOCHECKBOX    "", IDC_GX, 90, 63, 12, 10
    AUTOCHECKBOX    "", IDC_OX, 140, 63, 12, 10
    AUTOCHECKBOX    "Set&UID", IDC_SETUID, 7, 82, 50, 10
    AUTOCHECKBOX    "Set&GID", IDC_SETGID, 67, 82, 50, 10
    AUTOCHECKBOX    "S&ticky", IDC_STICKY, 127, 82, 50, 10
    LTEXT           "&Octal:", IDC_STATIC_7, 7, 100, 30, 8
    EDITTEXT        IDE_OCTAL, 40, 98, 40, 12, ES_AUTOHSCROLL
    AUTOCHECKBOX    "Apply to subdirectories &recursively", IDC_RECURSE, 7, 118, 190, 10
    AUTOCHECKBOX    "Set &modification time", IDC_SETTIME, 7, 132, 90, 10
    EDITTEXT        IDE_MTIME, 100, 130, 100, 12, ES_AUTOHSCROLL
    DEFPUSHBUTTON   "OK", IDOK, 98, 156, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 153, 156, 50, 14
END

IDD_OWNERGROUP DIALOGEX 0, 0, 220, 120
