IDD_LOGS DIALOGEX 0, 0, 400, 260
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX
CAPTION "SFTP Logs"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
