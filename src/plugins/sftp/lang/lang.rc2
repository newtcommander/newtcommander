IDD_CONFIG DIALOGEX 0, 0, 260, 236
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Connect timeout (s):", IDC_STATIC_1, 7, 9, 90, 8
    EDITTEXT        IDE_CONNECTTIMEOUT, 130, 7, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Operation timeout (s):", IDC_STATIC_2, 7, 25, 90, 8
    EDITTEXT        IDE_OPTIMEOUT, 130, 23, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Keep-alive every (s):", IDC_STATIC_3, 7, 41, 90, 8
    EDITTEXT        IDE_KEEPALIVE, 130, 39, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Keep-alive stop after (min):", IDC_STATIC_4, 7, 57, 110, 8
    EDITTEXT        IDE_KEEPALIVESTOP, 130, 55, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Connect retries:", IDC_STATIC_5, 7, 73, 90, 8
    EDITTEXT        IDE_CONNRETRIES, 130, 71, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Retry delay (s):", IDC_STATIC_6, 7, 89, 90, 8
    EDITTEXT        IDE_RETRYDELAY, 130, 87, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Resume overlap (bytes):", IDC_STATIC_7, 7, 105, 100, 8
    EDITTEXT        IDE_RESUMEOVERLAP, 130, 103, 40, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT           "Resume min size (bytes):", IDC_STATIC_8, 7, 121, 100, 8
    EDITTEXT        IDE_RESUMEMINSIZE, 130, 119, 50, 12, ES_AUTOHSCROLL | ES_NUMBER
    GROUPBOX        "Permissions column", IDC_STATIC_9, 7, 140, 246, 46
    AUTORADIOBUTTON "Show &Unix rights (drwxr-xr-x)", IDC_COLVIEW_RIGHTS, 14, 153, 160, 10, WS_GROUP
    AUTORADIOBUTTON "Show classic &attributes", IDC_COLVIEW_ATTR, 14, 165, 160, 10
    AUTOCHECKBOX    "Show &octal mode in information line", IDC_SHOWOCTAL, 130, 153, 118, 10
    AUTOCHECKBOX    "Enable session &logging", IDC_ENABLELOG, 7, 194, 120, 10
    LTEXT           "Log max size (KB):", IDC_STATIC_10, 130, 195, 70, 8
    EDITTEXT        IDE_LOGMAXSIZE, 205, 193, 45, 12, ES_AUTOHSCROLL | ES_NUMBER
END

